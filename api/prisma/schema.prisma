// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  username          String
  password          String
  role              Role              @default(USER)
  documents         Document[]
  documentHistories DocumentHistory[]
  conversations     Conversation[]
  userPermissions   UserPermissions?
}

model Document {
  id                Int               @id @default(autoincrement())
  title             String
  text              String            @default("")
  public            Boolean           @default(false)
  created_at        DateTime          @default(now())
  last_update       DateTime          @default(now())
  author            User              @relation(fields: [authorId], references: [id])
  authorId          Int
  documentHistories DocumentHistory[]
  conversations     Conversation[]
}

enum DocumentType {
  TEXT
  EXCEL
}

model DocumentHistory {
  id         Int      @id @default(autoincrement())
  title      String
  text       String
  public     Boolean
  document   Document @relation(fields: [documentId], references: [id])
  created_at DateTime @default(now())
  documentId Int
  author     User     @relation(fields: [authorId], references: [id])
  authorId   Int
}

model Scraper {
  id          Int           @id @default(autoincrement())
  name        String
  description String?       @default("")
  code        String?       @default("")
  browser     Boolean       @default(false)
  base_url    String[]
  status      ScraperStatus @default(DISABLE)
  created_at  DateTime      @default(now())
  last_update DateTime      @default(now())
}

model InstanceScrape {
  id          Int                  @id @default(autoincrement())
  url         String
  response    Json?
  status      InstanceScrapeStatus @default(IN_QUEUE)
  created_at  DateTime             @default(now())
  last_update DateTime             @default(now())
}

model Conversation {
  id         Int       @id @default(autoincrement())
  message    String
  response   String
  model_id   String
  document   Document? @relation(fields: [documentId], references: [id])
  documentId Int?
  author     User?     @relation(fields: [authorId], references: [id])
  authorId   Int?
  created_at DateTime  @default(now())
}

enum InstanceScrapeStatus {
  IN_QUEUE
  STARTING
  WORKING
  FINISHED
  ERROR
}

enum ScraperStatus {
  ACTIVE
  DISABLE
}

enum Role {
  USER
  ADMIN
}

model UserPermissions {
  id                          Int     @id @default(autoincrement())
  modifyScraper               Boolean @default(false)
  useScraper                  Boolean @default(false)
  modifyScraperStatus         Boolean @default(false)
  deleteScraper               Boolean @default(false)
  createDocument              Boolean @default(false)
  deleteDocument              Boolean @default(false)
  modifyDocument              Boolean @default(false)
  useAiChatBot                Boolean @default(false)
  accessScrapersPage          Boolean @default(false)
  accessInstancesScrapersPage Boolean @default(false)
  userId                      Int     @unique
  user                        User    @relation(fields: [userId], references: [id])
}
