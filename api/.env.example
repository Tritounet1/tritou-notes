PORT=3000
NODE_ENV=development
DATABASE_URL=
# Session signing secret: openssl rand -hex 32 (SECRET_JTW_KEY, its former name, is still read)
JWT_SECRET=
FRONTEND_URL="http://localhost:5173"
# 64 hex characters: openssl rand -hex 32. Changing it makes stored secrets unreadable.
ENCRYPTION_KEY=

# Persistent local directory; relative paths are resolved from the API working directory.
IMAGE_STORAGE_PATH=./uploads/images
