generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  username          String
  password          String
  role              Role              @default(USER)
  documents         Document[]
  documentHistories DocumentHistory[]
  conversations     Conversation[]
  userPermissions   UserPermissions?
}

model Document {
  id                Int               @id @default(autoincrement())
  title             String
  text              String            @default("")
  public            Boolean           @default(false)
  created_at        DateTime          @default(now())
  last_update       DateTime          @default(now())
  author            User              @relation(fields: [authorId], references: [id])
  authorId          Int
  type              DocumentType      @default(TEXT)
  documentHistories DocumentHistory[]
  conversations     Conversation[]
}

enum DocumentType {
  TEXT
  EXCEL
  TODO
}

model ScrapingScheduler {
  id                      Int                     @id @default(autoincrement())
  title                   String
  description             String?
  InstanceScrapes         InstanceScrape[]
  cron_expression         String?
  start_at                DateTime?
  last_run_at             DateTime?
  next_run_at             DateTime?
  status                  ScrapingSchedulerStatus @default(DESACTIVATE)
  update_at               DateTime                @default(now())
  created_at              DateTime                @default(now())
  instanceScrapeHistories InstanceScrapeHistory[]
}

enum ScrapingSchedulerStatus {
  DESACTIVATE
  RUNNING
  ERROR
  ACTIVATE
}

model DocumentHistory {
  id         Int      @id @default(autoincrement())
  title      String
  text       String
  public     Boolean
  document   Document @relation(fields: [documentId], references: [id])
  created_at DateTime @default(now())
  documentId Int
  author     User     @relation(fields: [authorId], references: [id])
  authorId   Int
}

model Scraper {
  id               Int              @id @default(autoincrement())
  name             String
  description      String?          @default("")
  code             String?          @default("")
  browser          Boolean          @default(false)
  base_url         String[]
  status           ScraperStatus    @default(DISABLE)
  created_at       DateTime         @default(now())
  last_update      DateTime         @default(now())
  display_template Json?
  instanceScrapes  InstanceScrape[]
}

model InstanceScrape {
  id                      Int                     @id @default(autoincrement())
  url                     String
  response                Json?
  status                  InstanceScrapeStatus    @default(IN_QUEUE)
  created_at              DateTime                @default(now())
  last_update             DateTime                @default(now())
  scrapingScheduler       ScrapingScheduler?      @relation(fields: [scrapingSchedulerId], references: [id])
  scrapingSchedulerId     Int?
  instanceScrapeHistories InstanceScrapeHistory[]
  scraper                 Scraper?                @relation(fields: [scraperId], references: [id])
  scraperId               Int?
}

model InstanceScrapeHistory {
  id                  Int                  @id @default(autoincrement())
  url                 String
  response            Json
  status              InstanceScrapeStatus
  created_at          DateTime             @default(now())
  instanceScrape      InstanceScrape       @relation(fields: [instanceScrapeId], references: [id])
  instanceScrapeId    Int
  scrapingScheduler   ScrapingScheduler?   @relation(fields: [scrapingSchedulerId], references: [id])
  scrapingSchedulerId Int?
}

model Conversation {
  id         Int       @id @default(autoincrement())
  message    String
  response   String
  model_id   String
  document   Document? @relation(fields: [documentId], references: [id])
  documentId Int?
  author     User?     @relation(fields: [authorId], references: [id])
  authorId   Int?
  created_at DateTime  @default(now())
}

enum InstanceScrapeStatus {
  IN_QUEUE
  STARTING
  WORKING
  FINISHED
  ERROR
}

enum ScraperStatus {
  ACTIVE
  DISABLE
}

enum Role {
  USER
  ADMIN
}

model UserPermissions {
  id                          Int     @id @default(autoincrement())
  modifyScraper               Boolean @default(false)
  useScraper                  Boolean @default(false)
  modifyScraperStatus         Boolean @default(false)
  deleteScraper               Boolean @default(false)
  createDocument              Boolean @default(false)
  deleteDocument              Boolean @default(false)
  modifyDocument              Boolean @default(false)
  useAiChatBot                Boolean @default(false)
  accessScrapersPage          Boolean @default(false)
  accessInstancesScrapersPage Boolean @default(false)
  userId                      Int     @unique
  user                        User    @relation(fields: [userId], references: [id])
}

model Invitation {
  id         Int      @id @default(autoincrement())
  email      String
  token      String   @unique
  used       Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
}

model Settings {
  id              Int     @id @default(autoincrement())
  anthropicApiKey String?
  smtpUser        String?
  smtpPassword    String?
  smtpHost        String?
  smtpPort        Int?
}

model Images {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
}
